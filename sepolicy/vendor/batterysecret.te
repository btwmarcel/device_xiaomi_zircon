type batterysecret, domain;
type batterysecret_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(batterysecret)

allow batterysecret sysfs_type:dir r_dir_perms;
allow batterysecret sysfs:file { getattr open read write };
allow batterysecret sysfs_batteryinfo:file { getattr open read write };
allow batterysecret sysfs_usb:file { getattr open read write };
allow batterysecret sysfs_wake_lock:file { getattr open read write };

allow batterysecret kmsg_device:chr_file { getattr open read write };

allow batterysecret self:netlink_kobject_uevent_socket { create bind read setopt getopt };

get_prop(batterysecret, build_prop)
get_prop(batterysecret, vendor_default_prop)

binder_call(batterysecret, hwservicemanager)
binder_call(batterysecret, hal_health_default)
allow batterysecret self:capability2 block_suspend;
allow batterysecret self:cap2_userns block_suspend;
