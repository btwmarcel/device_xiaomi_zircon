type hal_mtdservice_default, domain;
type hal_mtdservice_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_mtdservice_default)

allow hal_mtdservice_default same_process_hal_file:file { execute read open getattr map };
allow hal_mtdservice_default mitee_client_device:chr_file rw_file_perms;
allow hal_mtdservice_default tee_device:chr_file rw_file_perms;
allow hal_mtdservice_default ion_device:chr_file rw_file_perms;
binder_call(hal_mtdservice_default, servicemanager)
binder_call(hal_mtdservice_default, hwservicemanager)
add_hwservice(hal_mtdservice_default, hal_mtdservice_hwservice);
get_prop(hal_mtdservice_default, hwservicemanager_prop);
allow hal_mtdservice_default hal_keymint_default:binder { call transfer };
hal_client_domain(hal_mtdservice_default, hal_keymint)
allow hal_mtdservice_default hal_secure_element_default:binder transfer;
set_prop(hal_mtdservice_default, vendor_payment_security_prop);
get_prop(hal_mtdservice_default, vendor_default_prop);
allow hal_mtdservice_default mediadrm_vendor_data_file:dir rw_dir_perms;
allow hal_mtdservice_default mediadrm_vendor_data_file:file rw_file_perms;
allow hal_mtdservice_default mnt_vendor_file:dir search;
allow hal_mtdservice_default persist_data_file:dir { getattr search };
allow hal_mtdservice_default persist_data_file:file { getattr open read };
get_prop(hal_mtdservice_default, vendor_deviceid_prop);
