type hal_videoservice_default, domain;
type hal_videoservice_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_videoservice_default)

allow hal_videoservice_default same_process_hal_file:file { execute read open getattr map };
binder_call(hal_videoservice_default, servicemanager)
binder_call(hal_videoservice_default, hwservicemanager)
add_hwservice(hal_videoservice_default, hal_videoservice_hwservice);
get_prop(hal_videoservice_default, hwservicemanager_prop)
