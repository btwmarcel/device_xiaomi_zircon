type hal_otrpagent_default, domain;
type hal_otrpagent_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_otrpagent_default)

allow hal_otrpagent_default same_process_hal_file:file { execute read open getattr map };
allow hal_otrpagent_default mitee_client_device:chr_file rw_file_perms;
allow hal_otrpagent_default tee_device:chr_file rw_file_perms;
binder_call(hal_otrpagent_default, servicemanager)
binder_call(hal_otrpagent_default, hwservicemanager)
add_hwservice(hal_otrpagent_default, hal_otrpagent_hwservice);
get_prop(hal_otrpagent_default, hwservicemanager_prop)
