allow hal_fingerprint_default fingerprint_device:chr_file rw_file_perms;
allow hal_fingerprint_default vendor_displayfeature_device:chr_file rw_file_perms;

allow hal_fingerprint_default self:capability sys_nice;

hal_client_domain(hal_fingerprint_default, hal_power)

r_dir_file(hal_fingerprint_default, sysfs_type)
set_prop(hal_fingerprint_default, vendor_fingerprint_prop)
add_hwservice(hal_fingerprint_default, vendor_hal_fingerprint_hwservice)
set_prop(hal_fingerprint_default, vendor_fp_prop)
