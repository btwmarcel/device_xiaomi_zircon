type hal_tidaservice_default, domain;
type hal_tidaservice_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_tidaservice_default)

allow hal_tidaservice_default same_process_hal_file:file { execute read open getattr map };
allow hal_tidaservice_default mitee_client_device:chr_file rw_file_perms;
allow hal_tidaservice_default tee_device:chr_file rw_file_perms;
allow hal_tidaservice_default ion_device:chr_file rw_file_perms;
binder_call(hal_tidaservice_default, servicemanager)
binder_call(hal_tidaservice_default, hwservicemanager)
add_hwservice(hal_tidaservice_default, hal_tidaservice_hwservice);
get_prop(hal_tidaservice_default, hwservicemanager_prop);
get_prop(hal_tidaservice_default, vendor_default_prop);
