type vendor_displayfeature, domain;
type vendor_displayfeature_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_displayfeature)

type vendor_displayfeature_device, dev_type;
get_prop(vendor_displayfeature, hwservicemanager_prop)
allow vendor_displayfeature vndbinder_device:chr_file { ioctl map open read write };
binder_call(vendor_displayfeature, hwservicemanager)

allow vendor_displayfeature vendor_sysfs_displayfeature:dir r_dir_perms;
allow vendor_displayfeature vendor_sysfs_displayfeature:file rw_file_perms;
allow vendor_displayfeature vendor_displayfeature_device:chr_file rw_file_perms;
allow vendor_displayfeature sysfs_therm:dir search;
allow vendor_displayfeature sysfs_therm:file { getattr open read watch };
allow vendor_displayfeature vendor_data_file:dir { add_name write };
allow vendor_displayfeature vendor_data_file:file { create open read write };
add_hwservice(vendor_displayfeature, vendor_hal_displayfeature_xiaomi_hwservice)
allow vendor_displayfeature mnt_vendor_file:dir r_dir_perms;
unix_socket_connect(vendor_displayfeature, property, init)
