type vendor_hal_sensorcommunicate_default, domain;
type vendor_hal_sensorcommunicate_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_hal_sensorcommunicate_default)

allow vendor_hal_sensorcommunicate_default same_process_hal_file:file { execute read open getattr map };
binder_call(vendor_hal_sensorcommunicate_default, servicemanager)
binder_call(vendor_hal_sensorcommunicate_default, hwservicemanager)
binder_call(vendor_hal_sensorcommunicate_default, vendor_citsensor)
binder_call(vendor_hal_sensorcommunicate_default, system_server)
add_hwservice(vendor_hal_sensorcommunicate_default, vendor_hal_sensorcommunicate_hwservice);
allow vendor_hal_sensorcommunicate_default fwk_sensor_hwservice:hwservice_manager find;
allow vendor_hal_sensorcommunicate_default vendor_hal_citsensorservice_xiaomi_hwservice:hwservice_manager find;
set_prop(vendor_hal_sensorcommunicate_default, vendor_goodix_cct_prop);
get_prop(vendor_hal_sensorcommunicate_default, vendor_default_prop);
get_prop(vendor_hal_sensorcommunicate_default, hwservicemanager_prop)
allow hwservicemanager vendor_hal_sensorcommunicate_default:binder call;
