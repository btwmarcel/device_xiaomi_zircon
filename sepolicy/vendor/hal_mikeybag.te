type hal_mikeybag_default, domain;
type hal_mikeybag_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_mikeybag_default)

allow hal_mikeybag_default same_process_hal_file:file { execute read open getattr map };
allow hal_mikeybag_default mitee_client_device:chr_file rw_file_perms;
allow hal_mikeybag_default tee_device:chr_file rw_file_perms;
allow hal_mikeybag_default ion_device:chr_file rw_file_perms;
binder_call(hal_mikeybag_default, servicemanager)
add_service(hal_mikeybag_default, hal_mikeybag_service);
set_prop(hal_mikeybag_default, vendor_payment_security_prop);
get_prop(hal_mikeybag_default, vendor_default_prop);
