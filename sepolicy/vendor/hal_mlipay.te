type hal_mlipay_default, domain;
type hal_mlipay_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_mlipay_default)

allow hal_mlipay_default same_process_hal_file:file { execute read open getattr map };
allow hal_mlipay_default mitee_client_device:chr_file rw_file_perms;
allow hal_mlipay_default tee_device:chr_file rw_file_perms;
allow hal_mlipay_default ion_device:chr_file rw_file_perms;
binder_call(hal_mlipay_default, servicemanager)
binder_call(hal_mlipay_default, hwservicemanager)
add_hwservice(hal_mlipay_default, hal_mlipay_hwservice);
get_prop(hal_mlipay_default, hwservicemanager_prop);
set_prop(hal_mlipay_default, vendor_payment_security_prop);
get_prop(hal_mlipay_default, vendor_default_prop);
