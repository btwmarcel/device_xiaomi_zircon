service vendor.vibrator-alias /odm/bin/hw/android.hardware.vibrator-service.alias
    class hal
    user system
    group system
    oneshot

on property:init.svc.vibratorfeature-hal-service=restarting
    start vendor.vibrator-alias

on property:init.svc.vibratorfeature-hal-service=running
    start vendor.vibrator-alias
